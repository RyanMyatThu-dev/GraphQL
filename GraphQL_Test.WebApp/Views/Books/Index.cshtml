@model IEnumerable<GraphQL_Test.Database.Models.Book>

@{
    ViewData["Title"] = "Books Directory";
}

<div class="space-y-6">
    <!-- Header Area -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-white">Books Directory</h1>
            <p class="text-sm text-zinc-400 mt-1">Manage and view the collection of books registered in the system.</p>
        </div>
        <a asp-action="Create" class="inline-flex items-center px-4 py-2 text-xs font-semibold uppercase tracking-wider text-white bg-violet-600 rounded-lg shadow-md hover:bg-violet-500 active:bg-violet-700 transition-all duration-200 transform hover:-translate-y-0.5 hover:shadow-violet-600/10">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            Add New Book
        </a>
    </div>

    <!-- Data Table Card -->
    <div class="glass-card rounded-xl overflow-hidden shadow-2xl shadow-black/40">
        @if (!Model.Any())
        {
            <div class="flex flex-col items-center justify-center py-16 text-center px-6">
                <div class="w-12 h-12 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center mb-4 text-zinc-650">
                    <svg class="w-6 h-6 text-zinc-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                    </svg>
                </div>
                <h3 class="text-sm font-semibold text-zinc-200">No books found</h3>
                <p class="text-xs text-zinc-500 mt-1 max-w-xs">There are no books currently stored. Click "Add New Book" to populate the database.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-zinc-800 bg-zinc-950/40 text-xs font-semibold uppercase tracking-wider text-zinc-400">
                            <th class="py-3 px-5">ID</th>
                            <th class="py-3 px-5">Title</th>
                            <th class="py-3 px-5">Author</th>
                            <th class="py-3 px-5 text-right">Price</th>
                            <th class="py-3 px-5 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-800/60 text-sm">
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-zinc-900/30 transition-colors duration-150">
                                <td class="py-2.5 px-5 font-mono text-xs text-zinc-500">@item.Id</td>
                                <td class="py-2.5 px-5 font-medium text-white">@item.Title</td>
                                <td class="py-2.5 px-5 text-zinc-350">@item.Author</td>
                                <td class="py-2.5 px-5 text-right font-mono text-violet-300">@item.Price.ToString("C")</td>
                                <td class="py-2.5 px-5 text-center">
                                    <div class="inline-flex items-center space-x-1.5">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="p-1.5 text-zinc-400 hover:text-white rounded-md hover:bg-zinc-800/80 transition-all duration-150" title="Edit">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" />
                                            </svg>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="p-1.5 text-zinc-400 hover:text-white rounded-md hover:bg-zinc-800/80 transition-all duration-150" title="Details">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.43 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                            </svg>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="p-1.5 text-zinc-500 hover:text-red-400 rounded-md hover:bg-red-500/10 transition-all duration-150" title="Delete">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                                            </svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
