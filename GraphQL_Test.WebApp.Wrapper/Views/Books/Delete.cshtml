@model GraphQL_Test.Database.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<div class="max-w-xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center space-x-2 text-sm text-zinc-400">
        <a asp-action="Index" class="hover:text-zinc-200 transition-colors">Books</a>
        <span>/</span>
        <span class="text-zinc-200">Delete</span>
    </div>

    <div>
        <h1 class="text-2xl font-bold tracking-tight text-white text-red-500">Delete Book?</h1>
        <p class="text-sm text-zinc-400 mt-1">This action is permanent and cannot be undone.</p>
    </div>

    <!-- Details Card -->
    <div class="glass-card rounded-xl p-6 shadow-2xl space-y-5 border-red-500/20">
        <div class="space-y-4">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-zinc-450">Book Details</h3>
            
            <dl class="grid grid-cols-3 gap-4 text-sm border-t border-b border-zinc-800/80 py-4">
                <div class="col-span-1 text-zinc-500 font-medium">Title</div>
                <div class="col-span-2 text-white font-semibold">@Model.Title</div>

                <div class="col-span-1 text-zinc-500 font-medium">Author</div>
                <div class="col-span-2 text-zinc-300">@Model.Author</div>

                <div class="col-span-1 text-zinc-500 font-medium">Price</div>
                <div class="col-span-2 font-mono text-violet-300">@Model.Price.ToString("C")</div>
            </dl>
        </div>

        <form asp-action="Delete" class="flex items-center justify-end space-x-3">
            <input type="hidden" asp-for="Id" />
            <a asp-action="Index" class="px-4 py-2 text-xs font-semibold uppercase tracking-wider text-zinc-400 hover:text-zinc-100 transition-colors">
                Cancel, Keep Book
            </a>
            <button type="submit" class="inline-flex items-center px-4 py-2 text-xs font-semibold uppercase tracking-wider text-white bg-red-650 rounded-lg shadow-md hover:bg-red-650/90 active:bg-red-800 transition-all duration-200 transform hover:-translate-y-0.5">
                Yes, Delete Book
            </button>
        </form>
    </div>
</div>
